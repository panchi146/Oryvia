+    SetErrorLevel 1
+    Abort "$R1"
+  ${EndIf}
+  ${If} ${FileExists} "$INSTDIR\.install-scope.oryvia-new"
+    SetErrorLevel 1
+    Abort "A pending marker file already exists. Inspect it before retrying; it was not overwritten."
+  ${EndIf}
 !macroend
 
 !macro NSIS_HOOK_POSTINSTALL
-  ; Current main app provides the patched native uninstaller. Retire the old
-  ; custom uninstaller rather than restoring a potentially unsafe old binary.
-  Delete "$INSTDIR\uninstall.exe"
-  WriteRegStr SHCTX "${UNINSTKEY}" "UninstallString" "$\"$INSTDIR\${MAINBINARYNAME}.exe$\" --uninstall"
+  ; CLI 2.11.4 writes NSIS registration BEFORE POSTINSTALL. Keep its
+  ; uninstaller until marker and native registration have both succeeded.
+  StrCpy $R8 "user"
+  ${If} $MultiUser.InstallMode == "AllUsers"
+    StrCpy $R8 "all-users"
+  ${EndIf}
+  ClearErrors
+  FileOpen $R0 "$INSTDIR\.install-scope.oryvia-new" w
+  IfErrors oryvia_marker_failed
+  ClearErrors
+  FileWrite $R0 "$R8"
+  IfErrors oryvia_marker_write_failed
+  ClearErrors
+  FileClose $R0
+  IfErrors oryvia_marker_failed
+  ClearErrors
+  FileOpen $R0 "$INSTDIR\.install-scope.oryvia-new" r
+  IfErrors oryvia_marker_failed
+  ClearErrors
+  FileRead $R0 $R1
+  IfErrors oryvia_marker_write_failed
+  StrCmp $R1 $R8 0 oryvia_marker_write_failed
+  ClearErrors
+  FileClose $R0
+  IfErrors oryvia_marker_failed
+  ; Same-directory atomic replacement; preserve the previous marker on failure.
+  System::Call 'kernel32::MoveFileExW(w "$INSTDIR\.install-scope.oryvia-new", w "$INSTDIR\.install-scope", i 9) i .r0'
+  StrCmp $0 0 oryvia_marker_failed
   DeleteRegValue SHCTX "${UNINSTKEY}" "QuietUninstallString"
+  ClearErrors
+  WriteRegStr SHCTX "${UNINSTKEY}" "UninstallString" "$\"$INSTDIR\${MAINBINARYNAME}.exe$\" --uninstall"
   WriteRegDWORD SHCTX "${UNINSTKEY}" "NoModify" 1
   WriteRegDWORD SHCTX "${UNINSTKEY}" "NoRepair" 1
-  FileOpen $0 "$INSTDIR\.install-scope" w
-  ${If} $MultiUser.InstallMode == "AllUsers"
-    FileWrite $0 "all-users"
-  ${Else}
-    FileWrite $0 "user"
-  ${EndIf}
-  FileClose $0
+  IfErrors oryvia_marker_failed
+  Delete "$INSTDIR\uninstall.exe"
+  Goto oryvia_marker_done
+oryvia_marker_write_failed:
+  FileClose $R0
+oryvia_marker_failed:
+  Delete "$INSTDIR\.install-scope.oryvia-new"
+  ; If no valid marker remains, remove only this path's newly written entry.
+  ; A prior valid same-scope marker keeps a consistent registration for retry.
+  nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\oryvia-ownership.ps1" -Action MarkerFailureCleanup -InstallDir "$INSTDIR" -Scope "$R8"'
+  Pop $R0
+  Pop $R1
+  SetErrorLevel 1
